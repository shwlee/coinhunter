# Copy to .env. npm start loads it; existing shell variables take precedence.
AUTH_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
# Comma-separated Workspace domains (verified hd claim), or individual allowed emails.
# Empty lists permit any verified Google account in local development only.
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=
# Limits per direct TCP peer address. Shared NAT/VPN users share these quotas.
GOOGLE_AUTH_STARTS_PER_MINUTE=60
GOOGLE_AUTH_FLOWS_PER_ADDRESS=50
MOCK_COMPANY_DOMAIN=company.test
ACCOUNTS_FILE=data/accounts/store.json
ACCOUNT_STORE_ADAPTER=file
ALGORITHM_SOURCE_DIR=data/accounts/sources
PORT=3000
