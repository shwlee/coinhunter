# Copy to .env. npm start loads it; existing shell variables take precedence.
AUTH_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
# Comma-separated Workspace domains (verified hd claim), or individual allowed emails.
# Empty lists permit any verified Google account in local development only.
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=
# Limits per direct TCP peer address. Shared NAT/VPN users share these quotas.
GOOGLE_AUTH_STARTS_PER_MINUTE=60
GOOGLE_AUTH_FLOWS_PER_ADDRESS=50
MOCK_COMPANY_DOMAIN=company.test
ACCOUNTS_FILE=data/accounts/store.json
ACCOUNT_STORE_ADAPTER=file
ALGORITHM_SOURCE_DIR=data/accounts/sources
PORT=3000

# AI contracts (stage 1): not connected to server routes yet; no provider keys here.
AI_ENABLED=false
AI_ALLOW_STORED_CREDENTIALS=false
# Internal provider IDs. Empty means all supported providers.
AI_ALLOWED_PROVIDERS=anthropic,openai,gemini
# Empty means models discovered from the connection, subject to actual API permissions.
AI_ANTHROPIC_ALLOWED_MODELS=
AI_OPENAI_ALLOWED_MODELS=
AI_GEMINI_ALLOWED_MODELS=
AI_MAX_RUNNING=2
AI_MAX_RUNNING_PER_USER=1
AI_MAX_QUEUED=10
AI_MAX_QUEUED_PER_USER=1
AI_MAX_PREPARED=20
AI_MAX_PREPARED_PER_USER=2
AI_MAX_CANDIDATES_PER_USER=3
AI_CONNECTION_TIMEOUT_MS=10000
AI_REQUEST_TIMEOUT_MS=120000
AI_PREPARED_TTL_MS=120000
AI_CANDIDATE_TTL_MS=900000
