    "format:check": "prettier --check src public scripts test examples maps package.json .prettierrc.json .github",
    "verify:runtime": "node scripts/verify-runtime.js",
    "demo": "node scripts/demo-match.js"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "playwright-core": "1.51.1",
    "prettier": "3.9.9"
  }
}
