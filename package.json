{
  "name": "coinhunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coin Hunter web game and persistent algorithm runtime",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "build:editor": "node scripts/build-editor.js",
    "prestart": "npm run build:editor",
    "pretest:authoring": "npm run build:editor",
    "start": "node src/server.js",
    "maps": "node scripts/maps.js",
    "test": "node --test test",
    "test:browser": "node scripts/browser-smoke.js",
    "test:authoring": "node scripts/authoring-smoke.js",
    "format:check": "prettier --check src public scripts test examples maps package.json .prettierrc.json .github",
    "verify:runtime": "node scripts/verify-runtime.js",
    "demo": "node scripts/demo-match.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "acorn": "8.18.0",
    "codemirror": "6.0.2",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.51.1",
    "prettier": "3.9.9"
  }
}
