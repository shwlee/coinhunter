{
  "name": "coinhunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coin Hunter web game and persistent algorithm runtime",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "maps": "node scripts/maps.js",
    "test": "node --test test",
